# Copy the relevant block into backend/.env and frontend/.env.local. Never commit real values.

# ---------- backend/.env ----------
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cm_grievance
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:3000
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=15000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------- frontend/.env.local ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
